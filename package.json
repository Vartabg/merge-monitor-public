{
  "name": "merge-monitor",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-artifacts.mjs",
    "preview": "npm start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests server scripts orchestrator.mjs *.config.ts *.config.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "vitest run",
    "test:a11y": "npm run build && vitest run tests/dashboard.a11y.test.tsx tests/team-desk.a11y.test.tsx",
    "verify": "npm run generate:api && npm run lint && npm run test && npm run build",
    "install:service": "node scripts/install-service.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "team:queue": "node scripts/team-queue.mjs",
    "board": "node scripts/board-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
